<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="320.0" prefWidth="360.0" spacing="10.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inversiones.magdezis.controller.LoginController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Label text="Inversiones Magdezis" />
      <Label text="Iniciar sesión" />
      <Label text="Correo" />
      <TextField fx:id="txtCorreo" />
      <Label text="Contraseña" />
      <PasswordField fx:id="txtContrasena" />
      <Button mnemonicParsing="false" onAction="#iniciarSesion" text="Ingresar" />
      <Button mnemonicParsing="false" onAction="#irRegistro" text="Registrarse" />
   </children>
</VBox>
