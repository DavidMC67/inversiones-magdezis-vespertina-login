<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="360.0" spacing="10.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inversiones.magdezis.controller.RegistroController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Label text="Registro de usuario" />
      <Label text="Nombre" />
      <TextField fx:id="txtNombre" />
      <Label text="Apellido" />
      <TextField fx:id="txtApellido" />
      <Label text="Correo" />
      <TextField fx:id="txtCorreo" />
      <Label text="Contraseña" />
      <PasswordField fx:id="txtContrasena" />
      <Label text="Rol" />
      <ComboBox fx:id="cmbRol" prefWidth="300.0" />
      <Button mnemonicParsing="false" onAction="#registrar" text="Registrar" />
      <Button mnemonicParsing="false" onAction="#volver" text="Volver" />
   </children>
</VBox>
